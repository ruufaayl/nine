# ── Database ──
DATABASE_URL=postgresql://user:password@host:port/dbname?sslmode=require

# ── App URL (used for OAuth callback URLs) ──
APP_URL=http://localhost:5199

# ── WebSocket ──
VITE_WS_URL=https://your-ws-server.com/

# ── Email (Resend) ──
RESEND_API_KEY=re_xxxxxxxxxxxx

# ── Google OAuth ──
# 1. Go to https://console.cloud.google.com → APIs & Services → Credentials
# 2. Create OAuth 2.0 Client ID (Web Application)
# 3. Add redirect URI: {APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Facebook OAuth ──
# 1. Go to https://developers.facebook.com → My Apps → Create App
# 2. Add Facebook Login product
# 3. Set Valid OAuth Redirect URI: {APP_URL}/api/auth/facebook/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
